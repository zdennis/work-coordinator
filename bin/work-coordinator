#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

$stdout.sync = true
$stderr.sync = true

require "optparse"
require "term/ansicolor"
require_relative "../lib/work_coordinator"

# Captured before OptionParser and ARGV.shift destroy it; a restart re-execs
# with exactly the arguments this process was launched with.
ORIGINAL_ARGV = ARGV.dup.freeze

include Term::ANSIColor # rubocop:disable Style/MixinUsage

def colorize_state(state)
  case state.to_sym
  when :active             then green(state.to_s)
  when :waiting_for_human  then yellow(state.to_s)
  when :blocked            then red(state.to_s)
  when :completed          then cyan(state.to_s)
  else state.to_s
  end
end

def resolve_project_id(container, name)
  return nil unless name

  result = container.project_resolver.resolve(name)
  return result.project.id if result.found?

  warn "Unknown project: #{name}"
  exit 1
end

COMMANDS = {
  "init" => "Create the default config file (~/.config/work-coordinator/config.yml)",
  "alias" => "List, add, or remove workspace project aliases",
  "config" => "Read or write a configuration property",
  "project" => "Manage projects (add, list, set-default)",
  "register" => "Register a new work item",
  "start" => "Transition a work item to active state",
  "status" => "List all work items with their current state and phase",
  "work-items" => "Manage and inspect work items (subcommands: status)",
  "send" => "Send a message to the running coordinator via socket",
  "workspace" => "Dispatch a command to a named registered workspace agent",
  "run" => "Start the coordinator daemon (local socket or Messages mode)",
  "notify" => "Send a human notification for a work item",
  "report" => "Send a status report to the running coordinator's status socket"
}.freeze

global = OptionParser.new do |opts|
  opts.banner = "Usage: work-coordinator [command] [options]"

  opts.separator ""
  opts.separator "Commands:"
  COMMANDS.each { |cmd, desc| opts.separator "    #{cmd.ljust(12)}  #{desc}" }
  opts.separator ""
  opts.separator "Run 'work-coordinator <command> --help' for command-specific options."
  opts.separator ""
  opts.separator "Options:"

  opts.on("-v", "--version", "Print version") do
    puts WorkCoordinator::VERSION
    exit
  end
  opts.on("-h", "--help", "Print help") do
    puts opts
    exit
  end
end

global.order!(ARGV)
command = ARGV.shift

case command
when "init"
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator init"
    opts.separator ""
    opts.separator "Create the default configuration file at:"
    opts.separator "  ~/.config/work-coordinator/config.yml"
    opts.separator ""
    opts.separator "If the file already exists, init checks whether status_reporting_template"
    opts.separator "is present. If it is missing it adds the default template. If the template"
    opts.separator "already exists it asks before overwriting."
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  work-coordinator init"
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)

  config = WorkCoordinator::Config.new
  if !config.exist?
    config.write_defaults!
    puts "Created #{config.path}"
  elsif !config.status_reporting_template?
    config.write_status_reporting_template(WorkCoordinator::Config::DEFAULT_STATUS_REPORTING_TEMPLATE)
    puts "Added default status_reporting_template to #{config.path}"
  else
    $stdout.print "status_reporting_template already set. Overwrite? [y/N] "
    answer = $stdin.gets&.strip&.downcase
    if answer == "y"
      config.write_status_reporting_template(WorkCoordinator::Config::DEFAULT_STATUS_REPORTING_TEMPLATE)
      puts "Updated status_reporting_template in #{config.path}"
    else
      puts "No changes made."
    end
  end

when "alias"
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator alias [list|add SHORT PROJECT|remove SHORT]"
    opts.separator ""
    opts.separator "Manage short aliases for workspace project names, so you can type"
    opts.separator "'MS' instead of 'my-service' when referring to a workspace project."
    opts.separator ""
    opts.separator "Subcommands:"
    opts.separator "    list              Show all configured aliases (default)"
    opts.separator "    add SHORT NAME    Add or overwrite an alias"
    opts.separator "    remove SHORT      Remove an alias"
    opts.separator ""
    opts.separator "SHORT is upcased and trimmed (e.g. 'ge' becomes 'MS'). 'add' overwrites"
    opts.separator "an existing alias with the same SHORT name silently. SHORT and NAME are"
    opts.separator "not validated against 'workspace list' — typos are stored as-is."
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  work-coordinator alias"
    opts.separator "  work-coordinator alias add GE my-service"
    opts.separator "  work-coordinator alias remove GE"
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)

  config = WorkCoordinator::Config.new
  subcommand = ARGV.shift || "list"

  case subcommand
  when "list"
    aliases = config.aliases
    if aliases.empty?
      puts "No aliases configured."
    else
      fmt = "%-10s  %s"
      puts format(fmt, "SHORT", "PROJECT")
      aliases.each { |short, project| puts format(fmt, short, project) }
    end
  when "add"
    short = ARGV.shift&.strip&.upcase
    project = ARGV.shift&.strip
    if short.nil? || short.empty? || project.nil? || project.empty?
      warn "Usage: work-coordinator alias add SHORT PROJECT"
      exit 1
    end
    config.set_alias(short, project)
    puts "Added alias: #{short} -> #{project}"
  when "remove"
    short = ARGV.shift&.strip&.upcase
    if short.nil? || short.empty?
      warn "Usage: work-coordinator alias remove SHORT"
      exit 1
    end
    if config.remove_alias(short)
      puts "Removed alias: #{short}"
    else
      warn "No such alias: #{short}"
      exit 1
    end
  else
    warn "Unknown alias subcommand: #{subcommand}"
    warn "Usage: work-coordinator alias [list|add SHORT PROJECT|remove SHORT]"
    exit 1
  end

when "config"
  SUPPORTED_CONFIG_KEYS = %w[
    ai_command
    role
    default_message_role
    instruction_context
    slash_commands_enabled
    tmux_fallback_enabled
    dispatch_via_sockets
    implicit_reply_enabled
    auto_launch_workspace
    workspace_launch_timeout_seconds
  ].freeze

  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator config <key> [value]"
    opts.separator ""
    opts.separator "Read or write a configuration property."
    opts.separator ""
    opts.separator "Supported keys:"
    SUPPORTED_CONFIG_KEYS.each { |k| opts.separator "    #{k}" }
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  work-coordinator config role"
    opts.separator "  work-coordinator config role home"
    opts.separator "  work-coordinator config slash_commands_enabled false"
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.order!(ARGV)

  key   = ARGV.shift
  value = ARGV.shift

  if key.nil? || key.empty?
    config = WorkCoordinator::Config.new
    puts config.path
    puts File.read(config.path) if config.exist?
    exit
  end

  unless SUPPORTED_CONFIG_KEYS.include?(key)
    warn "Unknown config key: #{key}"
    warn "Supported keys: #{SUPPORTED_CONFIG_KEYS.join(', ')}"
    exit 1
  end

  config = WorkCoordinator::Config.new

  if value.nil?
    method_name = config.respond_to?(:"#{key}?") ? :"#{key}?" : key.to_sym
    raw = config.send(method_name)
    puts raw
  else
    coerced =
      case value.downcase
      when "true"  then true
      when "false" then false
      when /\A\d+\z/ then value.to_i
      else value
      end
    new_data = config.__send__(:data).dup
    new_data[key] = coerced
    config.__send__(:write_data!, new_data)
    puts coerced
  end

when "project"
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator project <subcommand> [options]"
    opts.separator ""
    opts.separator "Manage projects that group work items and map to tmux workspace sessions."
    opts.separator ""
    opts.separator "Subcommands:"
    opts.separator "    add NAME [--alias ALIAS] [--workspace NAME]   Add a new project"
    opts.separator "    list                                          List all projects"
    opts.separator "    set-default NAME_OR_ALIAS                     Set the default project"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  work-coordinator project add my-service --alias GE --workspace my-service"
    opts.separator "  work-coordinator project list"
    opts.separator "  work-coordinator project set-default GE"
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.order!(ARGV)

  require "securerandom"
  subcommand = ARGV.shift
  container  = WorkCoordinator::Container.new

  case subcommand
  when "add"
    project_options = {}
    OptionParser.new do |opts|
      opts.on("--alias ALIAS", "Short alias for routing (e.g. GE)") { |v| project_options[:alias] = v }
      opts.on("--workspace NAME", "Tmux session name for this project") { |v| project_options[:workspace] = v }
    end.parse!(ARGV)

    name = ARGV.shift
    unless name && !name.strip.empty?
      warn "Usage: work-coordinator project add NAME [--alias ALIAS] [--workspace NAME]"
      exit 1
    end

    now     = Time.now
    project = WorkCoordinator::Domain::Project.new(
      id: SecureRandom.uuid,
      name: name.strip,
      alias: project_options[:alias]&.strip,
      workspace_name: project_options[:workspace]&.strip,
      is_default: false,
      created_at: now,
      updated_at: now
    )
    saved = begin
      container.project_repo.save(project)
    rescue ActiveRecord::RecordNotUnique
      warn "Error: a project with alias '#{project_options[:alias]}' already exists."
      exit 1
    rescue ActiveRecord::RecordInvalid => e
      warn "Error: #{e.message}"
      exit 1
    end
    puts "Added project: #{saved.name}" + (saved.alias ? " (#{saved.alias})" : "")

  when "list"
    projects = container.project_repo.find_all
    if projects.empty?
      puts "No projects."
    else
      fmt = "%-10s  %-20s  %-20s  %s"
      puts format(fmt, "ALIAS", "NAME", "WORKSPACE", "")
      puts "-" * 60
      projects.each do |p|
        default_marker = p.is_default ? "[default]" : "" # rubocop:disable Metrics/BlockNesting
        puts format(fmt, p.alias.to_s, p.name, p.workspace_name.to_s, default_marker)
      end
    end

  when "set-default"
    name_or_alias = ARGV.shift
    unless name_or_alias && !name_or_alias.strip.empty?
      warn "Usage: work-coordinator project set-default NAME_OR_ALIAS"
      exit 1
    end
    result = container.set_default_project.call(query: name_or_alias)
    if result.success
      puts result.message
    else
      warn result.message
      exit 1
    end

  else
    warn "Unknown project subcommand: #{subcommand}"
    warn "Usage: work-coordinator project <add|list|set-default>"
    exit 1
  end

when "register"
  options = {}
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator register --title TITLE --kind KIND [options]"

    opts.separator ""
    opts.separator "Register a new work item in the coordinator. The item starts in a pending"
    opts.separator "state and must be started with the 'start' command before work begins."
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Minimal registration"
    opts.separator "  work-coordinator register --title 'Fix login timeout' --kind bug"
    opts.separator ""
    opts.separator "  # Link to a GitHub issue and associate a tmux pane"
    opts.separator "  work-coordinator register --title 'Add OAuth support' --kind feature \\"
    opts.separator "    --ref '#42' --repo my-app --tmux work:1.0"
    opts.separator ""
    opts.separator "  # Capture the ID for use in subsequent commands"
    opts.separator "  ID=$(work-coordinator register --title 'Refactor auth' --kind chore | awk '/^id:/{print $2}')"
    opts.separator "  work-coordinator start $ID"
    opts.separator ""
    opts.separator "Required:"
    opts.on("--title TITLE", "Short descriptive title for the work item") { |v| options[:title] = v }
    opts.on("--kind KIND",   "Type of work item (e.g. feature, bug, chore)") { |v| options[:kind] = v.to_sym }
    opts.separator ""
    opts.separator "Optional:"
    opts.on("--ref REF",   "External reference (e.g. GitHub issue or PR number)") { |v| options[:ref] = v }
    opts.on("--repo REPO", "Repository name or path this work item belongs to") { |v| options[:repo] = v }
    opts.on("--tmux TARGET", "Tmux target in SESSION:WINDOW.PANE format to associate with this item") do |v|
      options[:tmux] = v
    end
    opts.on("--project ALIAS", "Tag work item with this project alias (defaults to default project)") do |v|
      options[:project] = v
    end
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)

  %i[title kind].each do |req|
    unless options[req]
      warn "Missing required option: --#{req}"
      exit 1
    end
  end

  container = WorkCoordinator::Container.new

  project_id = if options[:project]
                 result = container.project_resolver.resolve(options[:project])
                 if result.found?
                   result.project.id
                 else
                   warn "Unknown project: #{options[:project]}"
                   exit 1
                 end
               end

  work_item = container.register_work_item.call(
    title: options[:title],
    kind: options[:kind],
    external_reference: options[:ref],
    repository: options[:repo],
    workspace_name: options[:tmux],
    project_id: project_id
  )
  puts "id:    #{work_item.id}"
  puts "state: #{work_item.state}"

when "start"
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator start <work-item-id>"
    opts.separator ""
    opts.separator "Transition a registered work item to the active state, indicating work"
    opts.separator "has begun. The work item ID is printed when you run 'register'."
    opts.separator ""
    opts.separator "Arguments:"
    opts.separator "    work-item-id    UUID of the work item to start"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Start a specific work item by ID"
    opts.separator "  work-coordinator start 4b1f9c2a-83de-4e7a-bf10-d1a2c3e4f567"
    opts.separator ""
    opts.separator "  # Register and immediately start in one shell pipeline"
    opts.separator "  ID=$(work-coordinator register --title 'Fix crash' --kind bug | awk '/^id:/{print $2}')"
    opts.separator "  work-coordinator start $ID"
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)

  id = ARGV.shift
  unless id
    warn "Usage: work-coordinator start <work-item-id>"
    exit 1
  end

  container = WorkCoordinator::Container.new
  item = container.start_work_item.call(work_item_id: id)
  puts "Started #{item.id} (state: #{item.state})"

when "status"
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator status"
    opts.separator ""
    opts.separator "List all registered work items with their ID, external reference,"
    opts.separator "current state, phase, and title. States are color-coded:"
    opts.separator "  active            (green)"
    opts.separator "  waiting_for_human (yellow)"
    opts.separator "  blocked           (red)"
    opts.separator "  completed         (cyan)"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Check what is currently in flight"
    opts.separator "  work-coordinator status"
    opts.separator ""
    opts.separator "  # Watch status refresh every 5 seconds"
    opts.separator "  watch -n 5 work-coordinator status"
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)

  container = WorkCoordinator::Container.new
  items = container.work_item_repo.find_all
  if items.empty?
    puts "No work items."
  else
    fmt = "%-36s  %-12s  %-20s  %-22s  %s"
    puts format(fmt, "ID", "REF", "STATE", "PHASE", "TITLE")
    puts "-" * 100
    items.each do |wi|
      puts format(fmt, wi.id, wi.external_reference.to_s, colorize_state(wi.state), wi.phase.to_s, wi.title)
    end
  end

when "work-items"
  WORK_ITEMS_USAGE = [
    "Usage: work-coordinator work-items <subcommand> [options]",
    "",
    "Subcommands:",
    "  status    Show status of work items",
    "",
    "Run 'work-coordinator work-items <subcommand> --help' for subcommand options."
  ].freeze

  OptionParser.new do |opts|
    opts.banner = WORK_ITEMS_USAGE.first
    opts.separator ""
    opts.separator "Inspect and manage work items tracked by the coordinator."
    opts.separator ""
    opts.separator "Subcommands:"
    opts.separator "    status    Show status of work items"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  work-coordinator work-items status"
    opts.separator "  work-coordinator work-items status --state active"
    opts.separator "  work-coordinator work-items status --project my-service"
    opts.separator ""
    opts.separator "Run 'work-coordinator work-items <subcommand> --help' for subcommand options."
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.order!(ARGV)

  subcommand = ARGV.shift

  case subcommand
  when "status"
    work_items_options = {}
    OptionParser.new do |opts|
      opts.banner = "Usage: work-coordinator work-items status [options]"
      opts.separator ""
      opts.separator "Show a table of work items with their state, phase, and title, preceded"
      opts.separator "by a header line naming this coordinator's role and whether it is running."
      opts.separator ""
      opts.separator "Examples:"
      opts.separator "  work-coordinator work-items status"
      opts.separator "  work-coordinator work-items status --state waiting_for_human"
      opts.separator "  work-coordinator work-items status --project my-service"
      opts.separator ""
      opts.separator "Options:"
      opts.on("--state STATE", "Only show work items in this state") { |v| work_items_options[:state] = v }
      opts.on("--project NAME", "Only show work items in this project") { |v| work_items_options[:project] = v }
      opts.on("-h", "--help", "Print help for this command") do
        puts opts
        exit
      end
    end.parse!(ARGV)

    state_filter = work_items_options[:state]&.strip&.to_sym
    if state_filter && !WorkCoordinator::Domain::WORK_ITEM_STATES.include?(state_filter)
      warn "Unknown state: #{state_filter}"
      warn "Valid states: #{WorkCoordinator::Domain::WORK_ITEM_STATES.join(', ')}"
      exit 1
    end

    container = WorkCoordinator::Container.new

    project_id_filter = resolve_project_id(container, work_items_options[:project])

    role = container.config.role || "unknown"
    running = File.exist?(WorkCoordinator::Paths.socket) ? "running" : "not running"
    separator = "─" * 84

    puts "Coordinator  role: #{role}  |  status: #{running}"
    puts separator
    puts ""

    items = container.work_item_repo.find_all(state: state_filter, project_id: project_id_filter)
    items = items.sort_by(&:created_at)

    header_fmt = "%-14s%-22s%-25s%s"
    row_fmt    = "%-14s%s%-25s%s"
    puts format(header_fmt, "REF", "STATE", "PHASE", "TITLE")
    puts separator
    if items.empty?
      puts "No work items found."
    else
      items.each do |wi|
        state_cell = colorize_state(wi.state) + (" " * [22 - wi.state.to_s.length, 1].max)
        title = wi.title.to_s
        title = "#{title[0, 49]}…" if title.length > 50
        puts format(row_fmt, wi.external_reference.to_s, state_cell, wi.phase.to_s, title)
      end
    end

  else
    warn "Unknown work-items subcommand: #{subcommand}" if subcommand
    WORK_ITEMS_USAGE.each { |line| warn line }
    exit 1
  end

when "send"
  OptionParser.new do |opts|
    opts.banner = 'Usage: work-coordinator send "REF body"'
    opts.separator ""
    opts.separator "Send a raw message to the running coordinator over its Unix socket."
    opts.separator "The message must begin with a work item reference so the coordinator"
    opts.separator "can route it to the correct item."
    opts.separator ""
    opts.separator "Arguments:"
    opts.separator '    "REF body"    Full message string; REF identifies the work item'
    opts.separator ""
    opts.separator "Environment:"
    opts.separator "    WC_SOCKET    Unix socket path (default: ~/.local/run/work-coordinator/work-coordinator.sock)"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Signal that a work item (ref #42) is blocked"
    opts.separator "  work-coordinator send '#42 blocked: waiting on API keys'"
    opts.separator ""
    opts.separator "  # Mark a work item as completed"
    opts.separator "  work-coordinator send '#42 done'"
    opts.separator ""
    opts.separator "  # Send via a custom socket path"
    opts.separator "  WC_SOCKET=/var/run/wc.sock work-coordinator send '#42 update: tests passing'"
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)

  message = ARGV.shift
  if message.nil? || message.strip.empty?
    warn 'Usage: work-coordinator send "REF body"'
    exit 1
  end

  sender = WorkCoordinator::Adapters::SocketMessageSender.new
  begin
    sender.send_message(body: message)
    puts "Sent: #{message}"
  rescue StandardError => e
    warn "Error sending message: #{e.message}"
    exit 1
  end

when "run"
  KNOWN_MODES = %i[local messages].freeze

  options = { modes: [] }
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator run [options]"
    opts.separator ""
    opts.separator "Start the coordinator daemon. In local mode it listens on a Unix socket"
    opts.separator "for messages sent with 'work-coordinator send'. In messages mode it polls"
    opts.separator "~/Library/Messages/chat.db for iMessages prefixed with 'ai: '."
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Start all modes (default)"
    opts.separator "  work-coordinator run"
    opts.separator ""
    opts.separator "  # Explicitly enable all modes"
    opts.separator "  work-coordinator run --mode all"
    opts.separator ""
    opts.separator "  # Start in local socket mode only"
    opts.separator "  work-coordinator run --mode local"
    opts.separator ""
    opts.separator "  # Explicit multi-mode"
    opts.separator "  work-coordinator run -m local,messages"
    opts.separator ""
    opts.separator "  # Run on a custom socket path"
    opts.separator "  WC_SOCKET=/var/run/wc.sock work-coordinator run"
    opts.separator ""
    opts.separator "  # Override the role this coordinator answers to"
    opts.separator "  work-coordinator run --role home"
    opts.separator ""
    opts.separator "Options:"
    opts.on("--role ROLE", "Role this coordinator answers to (overrides config)") do |v|
      options[:role] = v
    end
    opts.on("--debug", "Enable debug logging of message routing to stderr") do
      options[:debug] = true
    end
    opts.on("-m", "--mode MODE", "Receive mode (repeatable, comma-separated): all, local, messages") do |v|
      v.split(",").map(&:strip).each { |m| options[:modes] << m.to_sym }
    end
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)
  modes = options[:modes].empty? ? [:all] : options[:modes]
  modes = KNOWN_MODES.dup if modes.include?(:all)
  modes = modes.uniq
  unknown = modes.reject { |m| KNOWN_MODES.include?(m) }
  if unknown.any?
    warn "Unknown mode(s): #{unknown.join(', ')}. Valid modes: all, #{KNOWN_MODES.join(', ')}"
    exit 1
  end
  WorkCoordinator::Paths.ensure_run_dir
  socket_path = WorkCoordinator::Paths.socket
  container = WorkCoordinator::Container.new(
    config: WorkCoordinator::Config.load,
    modes: modes,
    argv: [$PROGRAM_NAME, *ORIGINAL_ARGV],
    env: ENV.to_h,
    debug: options.fetch(:debug, false),
    role: options[:role]
  )
  config = container.config
  container.restart_coordinator.announce_boot!

  if options.fetch(:debug, false)
    aliases_str = config.aliases.empty? ? "(none)" : config.aliases.map { |k, v| "#{k}→#{v}" }.join(", ")
    ctx = config.instruction_context.to_s
    ctx_str = if ctx.empty?
                "(none)"
              elsif ctx.length > 40
                "#{ctx[0, 40]}…"
              else
                ctx
              end
    container.logger.debug("work-coordinator booting")
    container.logger.debug("config: #{config.path}")
    container.logger.debug("mode(s): #{modes.join(', ')}")
    aliases_list = config.role_aliases.empty? ? "(none)" : config.role_aliases.join(", ")
    container.logger.debug("role: #{config.role}#{' (from --role)' if options[:role]}")
    container.logger.debug("role_aliases: #{aliases_list}")
    container.logger.debug("slash_commands_enabled: #{config.slash_commands_enabled?}")
    container.logger.debug("dispatch_via_sockets: #{config.dispatch_via_sockets?}")
    container.logger.debug("tmux_fallback_enabled: #{config.tmux_fallback_enabled?}")
    container.logger.debug("implicit_reply_enabled: #{config.implicit_reply_enabled?}")
    container.logger.debug("instruction_context: #{ctx_str}")
    container.logger.debug("aliases: #{aliases_str}")
  end

  modes.each do |m|
    case m
    when :local    then puts "work-coordinator running on #{socket_path} (local socket)"
    when :messages then puts "work-coordinator running in messages mode (polling ~/Library/Messages/chat.db)"
    end
  end
  puts "Listening for messages starting with: ai:" if modes.include?(:messages)
  puts "Press Ctrl-C to stop."

  status_socket_path = WorkCoordinator::Paths.status_socket
  puts "Accepting workspace agent status reports on #{status_socket_path}"
  status_thread = Thread.new { container.workspace_status_receiver.start }

  stop_all = proc do
    container.message_receiver.stop
    container.workspace_status_receiver.stop
  end
  Signal.trap("INT",  &stop_all)
  Signal.trap("TERM", &stop_all)

  container.message_receiver.start do |msg|
    raw = "#{msg[:work_item_ref]} #{msg[:body]}"
    result = container.route_message.call(raw_message: raw)
    if result.routed
      puts "Routed to #{result.work_item.id}: #{result.body}"
    else
      puts "Unrouted message: #{raw}"
    end
  rescue StandardError => e
    warn "Error routing message: #{e.message}"
  end

  container.workspace_status_receiver.stop
  status_thread.join(2)

when "notify"
  options = {}
  OptionParser.new do |opts|
    opts.banner = 'Usage: work-coordinator notify <work-item-id> "<body>" [options]'
    opts.separator ""
    opts.separator "Send a notification to a human for the given work item. Useful when a"
    opts.separator "work item reaches a state that requires human attention or approval."
    opts.separator ""
    opts.separator "Arguments:"
    opts.separator "    work-item-id    UUID of the work item"
    opts.separator '    "body"          Notification message to deliver'
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Notify via iMessage (default) that a work item needs review"
    opts.separator "  work-coordinator notify 4b1f9c2a-83de-4e7a-bf10-d1a2c3e4f567 'PR is ready for review'"
    opts.separator ""
    opts.separator "  # Notify via local socket instead of iMessage"
    opts.separator "  work-coordinator notify 4b1f9c2a-83de-4e7a-bf10-d1a2c3e4f567 'Build failed' --mode local"
    opts.separator ""
    opts.separator "Options:"
    opts.on("--mode MODE", %w[messages local], "Delivery mode: messages (default) or local") do |v|
      options[:mode] = v.to_sym
    end
    opts.on("-h", "--help", "Print help for this command") do
      puts opts
      exit
    end
  end.parse!(ARGV)
  id = ARGV.shift
  body = ARGV.shift
  unless id && body
    warn 'Usage: work-coordinator notify <id> "<body>" [--mode messages]'
    exit 1
  end
  mode = options[:mode] || :messages
  container = WorkCoordinator::Container.new(modes: [mode])
  container.notify_human.call(work_item_id: id, body: body)
  puts "Notification sent."

when "report"
  require "json"
  require "socket"

  REPORT_TYPES = %w[status_update phase_change pipeline_advanced task_complete error].freeze
  REPORT_REQUIRED_FIELDS = {
    "status_update" => [:message],
    "phase_change" => [:phase],
    "pipeline_advanced" => %i[from_pane to_pane],
    "task_complete" => [:summary],
    "error" => [:message]
  }.freeze

  options = {}
  begin
    OptionParser.new do |opts|
      opts.banner = "Usage: work-coordinator report --ref <ref> --type <type> [options]"
      opts.separator ""
      opts.separator "Send a single status report to the coordinator's status socket and exit."
      opts.separator "Intended to be run by an AI agent from inside a workspace pane."
      opts.separator ""
      opts.separator "Types and their required flags:"
      opts.separator "    status_update      --message"
      opts.separator "    phase_change       --phase"
      opts.separator "    pipeline_advanced  --from-pane and --to-pane"
      opts.separator "    task_complete      --summary"
      opts.separator "    error              --message"
      opts.separator ""
      opts.separator "Examples:"
      opts.separator '  work-coordinator report --ref WC-42 --type status_update --message "installing deps"'
      opts.separator "  work-coordinator report --ref WC-42 --type phase_change --phase implementing"
      opts.separator '  work-coordinator report --ref WC-42 --type error --message "bundle install failed"'
      opts.separator ""
      opts.separator "Options:"
      opts.on("--ref REF", "Work item ref (e.g. WC-42)") { |v| options[:ref] = v }
      opts.on("--type TYPE", REPORT_TYPES, "Report type: #{REPORT_TYPES.join(', ')}") { |v| options[:type] = v }
      opts.on("--workspace NAME", "Workspace name (default: $WC_WORKSPACE)") { |v| options[:workspace] = v }
      opts.on("--message TEXT", "Message body") { |v| options[:message] = v }
      opts.on("--phase TEXT", "New phase name") { |v| options[:phase] = v }
      opts.on("--summary TEXT", "One-line completion summary") { |v| options[:summary] = v }
      opts.on("--from-pane N", "Pane the pipeline moved from") { |v| options[:from_pane] = Integer(v) }
      opts.on("--to-pane N", "Pane the pipeline moved to") { |v| options[:to_pane] = Integer(v) }
      opts.on("--socket PATH", "Status socket path") { |v| options[:socket] = v }
      opts.on("-h", "--help", "Print help for this command") do
        puts opts
        exit
      end
    end.parse!(ARGV)
  rescue ArgumentError => e
    warn "work-coordinator report: #{e.message}"
    exit 1
  end

  unless options[:ref] && !options[:ref].strip.empty?
    warn "Usage: work-coordinator report --ref <ref> --type <type> ..."
    exit 1
  end
  unless options[:type]
    warn "Usage: work-coordinator report --ref <ref> --type <type> ..."
    exit 1
  end

  REPORT_REQUIRED_FIELDS.fetch(options[:type]).each do |field|
    unless options[field]
      warn "--type #{options[:type]} requires --#{field.to_s.tr('_', '-')}"
      exit 1
    end
  end

  payload = { type: options[:type], work_item_ref: options[:ref] }
  workspace = options[:workspace] || ENV.fetch("WC_WORKSPACE", nil)
  payload[:workspace] = workspace if workspace
  REPORT_REQUIRED_FIELDS.fetch(options[:type]).each { |f| payload[f] = options[f] }

  socket_path = options[:socket] || WorkCoordinator::Paths.status_socket
  report_read_timeout = 5

  sock = begin
    UNIXSocket.new(socket_path)
  rescue Errno::ENOENT, Errno::ECONNREFUSED => e
    warn "work-coordinator report: coordinator not reachable at #{socket_path} — skipping"
    exit 0
  end

  line = begin
    sock.write("#{JSON.generate(payload)}\n")
    sock.wait_readable(report_read_timeout) && sock.gets
  ensure
    sock.close
  end

  unless line
    warn "work-coordinator report: no reply from coordinator within #{report_read_timeout}s — skipping"
    exit 0
  end

  reply = begin
    JSON.parse(line)
  rescue JSON::ParserError
    warn "work-coordinator report: malformed reply: #{line.strip}"
    exit 1
  end

  if reply["ok"]
    exit 0
  else
    warn "work-coordinator report: #{reply['error']} (action: #{reply['action']})"
    exit({ "give_up" => 2, "abort_pipeline" => 3, "drop" => 4 }.fetch(reply["action"], 1))
  end

when "workspace"
  subcommand = ARGV.shift

  case subcommand
  when "send"
    options = {}
    OptionParser.new do |opts|
      opts.banner = "Usage: work-coordinator workspace send <name> <body>"
      opts.separator ""
      opts.separator "Dispatch a command to a named registered workspace agent through the coordinator."
      opts.separator ""
      opts.separator "Arguments:"
      opts.separator "    <name>    Registered agent name (e.g. homebrew-bin)"
      opts.separator "    <body>    Command text to forward"
      opts.separator ""
      opts.separator "Options:"
      opts.on("--ref REF", "Work item reference (coordinator generates one if omitted)") do |v|
        options[:work_item_ref] = v
      end
      opts.on("--from NAME", "Originating agent name, for audit logging") do |v|
        options[:from] = v
      end
      opts.separator ""
      opts.separator "Environment:"
      opts.separator "    WC_SOCKET    Unix socket path (default: ~/.local/run/work-coordinator/work-coordinator.sock)"
      opts.separator ""
      opts.separator "Examples:"
      opts.separator "  work-coordinator workspace send homebrew-bin 'update the formula to 0.23.0'"
      opts.separator "  work-coordinator workspace send myapp 'run tests' --ref WC-42"
      opts.on("-h", "--help", "Print help for this command") do
        puts opts
        exit
      end
    end.parse!(ARGV)

    name = ARGV.shift
    body = ARGV.shift

    if name.nil? || name.strip.empty?
      warn "Usage: work-coordinator workspace send <name> <body>"
      exit 1
    end
    if body.nil? || body.strip.empty?
      warn "Usage: work-coordinator workspace send <name> <body>"
      exit 1
    end

    client = WorkCoordinator::Adapters::WorkCoordinatorClient.new
    begin
      result = client.dispatch_to(name: name, body: body, **options.slice(:work_item_ref, :from))
    rescue Errno::ENOENT, Errno::ECONNREFUSED => e
      warn "work-coordinator workspace send: coordinator not reachable — #{e.message}"
      exit 1
    end

    if result[:ok]
      puts "Dispatched to #{name} (ref: #{result[:work_item_ref]})"
    else
      warn "work-coordinator workspace send: #{result[:error]} (target: #{result[:target]})"
      exit 1
    end

  when nil, "--help", "-h"
    puts "Usage: work-coordinator workspace <subcommand> [options]"
    puts ""
    puts "Subcommands:"
    puts "    send    Dispatch a command to a named registered workspace agent"
    puts ""
    puts "Run 'work-coordinator workspace <subcommand> --help' for subcommand options."
    exit subcommand.nil? ? 1 : 0

  else
    warn "Unknown workspace subcommand: #{subcommand}"
    warn "Run 'work-coordinator workspace --help' for usage."
    exit 1
  end

else
  puts global
  exit 1
end

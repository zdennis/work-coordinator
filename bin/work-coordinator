#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "optparse"
require "term/ansicolor"
require_relative "../lib/work_coordinator"

include Term::ANSIColor # rubocop:disable Style/MixinUsage

def colorize_state(state)
  case state.to_sym
  when :active             then green(state.to_s)
  when :waiting_for_human  then yellow(state.to_s)
  when :blocked            then red(state.to_s)
  when :completed          then cyan(state.to_s)
  else state.to_s
  end
end

COMMANDS = {
  "register" => "Register a new work item",
  "start"    => "Transition a work item to active state",
  "status"   => "List all work items with their current state and phase",
  "send"     => "Send a message to the running coordinator via socket",
  "run"      => "Start the coordinator daemon (local socket or Messages mode)",
  "notify"   => "Send a human notification for a work item"
}.freeze

global = OptionParser.new do |opts|
  opts.banner = "Usage: work-coordinator [command] [options]"

  opts.separator ""
  opts.separator "Commands:"
  COMMANDS.each { |cmd, desc| opts.separator "    #{cmd.ljust(12)}  #{desc}" }
  opts.separator ""
  opts.separator "Run 'work-coordinator <command> --help' for command-specific options."
  opts.separator ""
  opts.separator "Options:"

  opts.on("-v", "--version", "Print version") do
    puts WorkCoordinator::VERSION
    exit
  end
  opts.on("-h", "--help", "Print help") do
    puts opts
    exit
  end
end

global.order!(ARGV)
command = ARGV.shift

case command
when "register"
  options = {}
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator register --title TITLE --kind KIND [options]"

    opts.separator ""
    opts.separator "Register a new work item in the coordinator. The item starts in a pending"
    opts.separator "state and must be started with the 'start' command before work begins."
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Minimal registration"
    opts.separator "  work-coordinator register --title 'Fix login timeout' --kind bug"
    opts.separator ""
    opts.separator "  # Link to a GitHub issue and associate a tmux pane"
    opts.separator "  work-coordinator register --title 'Add OAuth support' --kind feature \\"
    opts.separator "    --ref '#42' --repo my-app --tmux work:1.0"
    opts.separator ""
    opts.separator "  # Capture the ID for use in subsequent commands"
    opts.separator "  ID=$(work-coordinator register --title 'Refactor auth' --kind chore | awk '/^id:/{print $2}')"
    opts.separator "  work-coordinator start $ID"
    opts.separator ""
    opts.separator "Required:"
    opts.on("--title TITLE", "Short descriptive title for the work item") { |v| options[:title] = v }
    opts.on("--kind KIND",   "Type of work item (e.g. feature, bug, chore)") { |v| options[:kind] = v.to_sym }
    opts.separator ""
    opts.separator "Optional:"
    opts.on("--ref REF",   "External reference (e.g. GitHub issue or PR number)") { |v| options[:ref] = v }
    opts.on("--repo REPO", "Repository name or path this work item belongs to") { |v| options[:repo] = v }
    opts.on("--tmux TARGET", "Tmux target in SESSION:WINDOW.PANE format to associate with this item") { |v| options[:tmux] = v }
    opts.on("-h", "--help", "Print help for this command") { puts opts; exit }
  end.parse!(ARGV)

  %i[title kind].each do |req|
    unless options[req]
      warn "Missing required option: --#{req}"
      exit 1
    end
  end

  container = WorkCoordinator::Container.new
  work_item = container.register_work_item.call(
    title: options[:title],
    kind: options[:kind],
    external_reference: options[:ref],
    repository: options[:repo],
    workspace_name: options[:tmux]
  )
  puts "id:    #{work_item.id}"
  puts "state: #{work_item.state}"

when "start"
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator start <work-item-id>"
    opts.separator ""
    opts.separator "Transition a registered work item to the active state, indicating work"
    opts.separator "has begun. The work item ID is printed when you run 'register'."
    opts.separator ""
    opts.separator "Arguments:"
    opts.separator "    work-item-id    UUID of the work item to start"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Start a specific work item by ID"
    opts.separator "  work-coordinator start 4b1f9c2a-83de-4e7a-bf10-d1a2c3e4f567"
    opts.separator ""
    opts.separator "  # Register and immediately start in one shell pipeline"
    opts.separator "  ID=$(work-coordinator register --title 'Fix crash' --kind bug | awk '/^id:/{print $2}')"
    opts.separator "  work-coordinator start $ID"
    opts.on("-h", "--help", "Print help for this command") { puts opts; exit }
  end.parse!(ARGV)

  id = ARGV.shift
  unless id
    warn "Usage: work-coordinator start <work-item-id>"
    exit 1
  end

  container = WorkCoordinator::Container.new
  item = container.start_work_item.call(work_item_id: id)
  puts "Started #{item.id} (state: #{item.state})"

when "status"
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator status"
    opts.separator ""
    opts.separator "List all registered work items with their ID, external reference,"
    opts.separator "current state, phase, and title. States are color-coded:"
    opts.separator "  active            (green)"
    opts.separator "  waiting_for_human (yellow)"
    opts.separator "  blocked           (red)"
    opts.separator "  completed         (cyan)"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Check what is currently in flight"
    opts.separator "  work-coordinator status"
    opts.separator ""
    opts.separator "  # Watch status refresh every 5 seconds"
    opts.separator "  watch -n 5 work-coordinator status"
    opts.on("-h", "--help", "Print help for this command") { puts opts; exit }
  end.parse!(ARGV)

  container = WorkCoordinator::Container.new
  items = container.work_item_repo.find_all
  if items.empty?
    puts "No work items."
  else
    fmt = "%-36s  %-12s  %-20s  %-22s  %s"
    puts format(fmt, "ID", "REF", "STATE", "PHASE", "TITLE")
    puts "-" * 100
    items.each do |wi|
      puts format(fmt, wi.id, wi.external_reference.to_s, colorize_state(wi.state), wi.phase.to_s, wi.title)
    end
  end

when "send"
  OptionParser.new do |opts|
    opts.banner = 'Usage: work-coordinator send "REF body"'
    opts.separator ""
    opts.separator "Send a raw message to the running coordinator over its Unix socket."
    opts.separator "The message must begin with a work item reference so the coordinator"
    opts.separator "can route it to the correct item."
    opts.separator ""
    opts.separator "Arguments:"
    opts.separator '    "REF body"    Full message string; REF identifies the work item'
    opts.separator ""
    opts.separator "Environment:"
    opts.separator "    WC_SOCKET    Unix socket path (default: /tmp/work-coordinator.sock)"
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Signal that a work item (ref #42) is blocked"
    opts.separator "  work-coordinator send '#42 blocked: waiting on API keys'"
    opts.separator ""
    opts.separator "  # Mark a work item as completed"
    opts.separator "  work-coordinator send '#42 done'"
    opts.separator ""
    opts.separator "  # Send via a custom socket path"
    opts.separator "  WC_SOCKET=/var/run/wc.sock work-coordinator send '#42 update: tests passing'"
    opts.on("-h", "--help", "Print help for this command") { puts opts; exit }
  end.parse!(ARGV)

  message = ARGV.shift
  if message.nil? || message.strip.empty?
    warn 'Usage: work-coordinator send "REF body"'
    exit 1
  end

  sender = WorkCoordinator::Adapters::SocketMessageSender.new
  begin
    sender.send_message(body: message)
    puts "Sent: #{message}"
  rescue StandardError => e
    warn "Error sending message: #{e.message}"
    exit 1
  end

when "run"
  options = { modes: [] }
  OptionParser.new do |opts|
    opts.banner = "Usage: work-coordinator run [options]"
    opts.separator ""
    opts.separator "Start the coordinator daemon. In local mode it listens on a Unix socket"
    opts.separator "for messages sent with 'work-coordinator send'. In messages mode it polls"
    opts.separator "~/Library/Messages/chat.db for iMessages prefixed with 'ai: '."
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Start in local socket mode (default)"
    opts.separator "  work-coordinator run"
    opts.separator ""
    opts.separator "  # Start in iMessage mode to receive messages from your phone"
    opts.separator "  work-coordinator run --mode messages"
    opts.separator ""
    opts.separator "  # Run both modes at once"
    opts.separator "  work-coordinator run --mode local --mode messages"
    opts.separator "  work-coordinator run --mode local,messages"
    opts.separator "  work-coordinator run -m local,messages"
    opts.separator ""
    opts.separator "  # Run on a custom socket path"
    opts.separator "  WC_SOCKET=/var/run/wc.sock work-coordinator run"
    opts.separator ""
    opts.separator "Options:"
    opts.on("-m", "--mode MODE", "Receive mode (repeatable, comma-separated): local, messages") do |v|
      v.split(",").map(&:strip).each { |m| options[:modes] << m.to_sym }
    end
    opts.on("-h", "--help", "Print help for this command") { puts opts; exit }
  end.parse!(ARGV)
  valid_modes = %i[local messages]
  unknown = options[:modes].reject { |m| valid_modes.include?(m) }
  if unknown.any?
    warn "Unknown mode(s): #{unknown.join(", ")}. Valid modes: #{valid_modes.join(", ")}"
    exit 1
  end
  modes = options[:modes].empty? ? [:local] : options[:modes]
  socket_path = ENV.fetch("WC_SOCKET", "/tmp/work-coordinator.sock")
  container = WorkCoordinator::Container.new(modes: modes)
  modes.each do |m|
    case m
    when :local    then puts "work-coordinator running on #{socket_path} (local socket)"
    when :messages then puts "work-coordinator running in messages mode (polling ~/Library/Messages/chat.db)"
    end
  end
  puts "Listening for messages starting with: ai:" if modes.include?(:messages)
  puts "Press Ctrl-C to stop."

  Signal.trap("INT")  { container.message_receiver.stop }
  Signal.trap("TERM") { container.message_receiver.stop }

  container.message_receiver.start do |msg|
    raw = "#{msg[:work_item_ref]} #{msg[:body]}"
    result = container.route_message.call(raw_message: raw)
    if result.routed
      puts "Routed to #{result.work_item.id}: #{result.body}"
    else
      puts "Unrouted message: #{raw}"
    end
  rescue StandardError => e
    warn "Error routing message: #{e.message}"
  end

when "notify"
  options = {}
  OptionParser.new do |opts|
    opts.banner = 'Usage: work-coordinator notify <work-item-id> "<body>" [options]'
    opts.separator ""
    opts.separator "Send a notification to a human for the given work item. Useful when a"
    opts.separator "work item reaches a state that requires human attention or approval."
    opts.separator ""
    opts.separator "Arguments:"
    opts.separator "    work-item-id    UUID of the work item"
    opts.separator '    "body"          Notification message to deliver'
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  # Notify via iMessage (default) that a work item needs review"
    opts.separator "  work-coordinator notify 4b1f9c2a-83de-4e7a-bf10-d1a2c3e4f567 'PR is ready for review'"
    opts.separator ""
    opts.separator "  # Notify via local socket instead of iMessage"
    opts.separator "  work-coordinator notify 4b1f9c2a-83de-4e7a-bf10-d1a2c3e4f567 'Build failed' --mode local"
    opts.separator ""
    opts.separator "Options:"
    opts.on("--mode MODE", %w[messages local], "Delivery mode: messages (default) or local") { |v| options[:mode] = v.to_sym }
    opts.on("-h", "--help", "Print help for this command") { puts opts; exit }
  end.parse!(ARGV)
  id = ARGV.shift
  body = ARGV.shift
  unless id && body
    warn 'Usage: work-coordinator notify <id> "<body>" [--mode messages]'
    exit 1
  end
  mode = options[:mode] || :messages
  container = WorkCoordinator::Container.new(modes: [mode])
  container.notify_human.call(work_item_id: id, body: body)
  puts "Notification sent."

else
  puts global
  exit 1
end
